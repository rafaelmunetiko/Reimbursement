        <messages/>
        <name>Read Only Image Field if State is Paid</name>
        <order/>
        <script><![CDATA[function onLoad() {
    var stateValue = g_form.getValue('state');
    var imageFieldName = 'receipt';

    if (stateValue === 'paid') {
        g_form.setReadOnly(imageFieldName, true);

        var uploadButton = document.querySelector('.icon-upload');
        if (uploadButton) {
            uploadButton.style.display = 'none';
        }

        var deleteButton = document.querySelector('.icon-delete');
        if (deleteButton) {
            deleteButton.style.display = 'none';
        }
    }
}]]></script>
