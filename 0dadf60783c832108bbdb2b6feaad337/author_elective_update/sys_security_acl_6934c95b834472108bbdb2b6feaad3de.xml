        <description>Allow write for records in x_752538_reimbur_0_reimbursement, for users with role x_752538_reimbur_0.reimbursement_resolver, and if the ACL script returns true.</description>
        <local_or_existing>Local</local_or_existing>
        <name>x_752538_reimbur_0_reimbursement</name>
        <operation display_value="write">write</operation>
        <script><![CDATA[(function() {

    var userGroups = gs.getUser().getMyGroups();

    var recordGroup = current.assignment_group.toString();

    if (gs.action.getGlideURI().toString().includes("sysparm_query") || userGroups.includes(recordGroup)) {
        return true; 
    }

    return false;
})();]]></script>
