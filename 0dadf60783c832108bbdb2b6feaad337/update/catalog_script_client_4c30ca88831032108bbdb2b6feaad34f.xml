        <messages/>
        <name>Amount Validation </name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue == '') {
        return;
    }

    var money = newValue.replace(',', '.');

    var num = parseFloat(money);

    if (isNaN(num)) {
        g_form.clearValue('amount');
        g_form.showFieldMsg('amount', 'Enter a valid amount.', 'error');
        return;
    }

    if (num === 0) {
        g_form.clearValue('amount');
        g_form.showFieldMsg('amount', 'Amount cannot be zero.', 'error');
        return;
    }


    var formatted = num.toFixed(2);

    g_form.setValue('amount', formatted);

    g_form.hideFieldMsg('amount');

}]]></script>
