        <script><![CDATA[function onSubmit() {
    var amount = g_form.getValue('amount');
    var category = g_form.getDisplayValue('category');
    var date = g_form.getValue('date');
    var description = g_form.getValue('description');

    var summary = "Please confirm the details:\n\n" +
                  "Amount: " + amount + "\n" +
                  "Category: " + category + "\n" +
                  "Date: " + date + "\n" +
                  "Description: " + description + "\n\n" +
                  "Do you want to submit?";

    if (!confirm(summary)) {
        return false; 
    }
    return true; 
}
